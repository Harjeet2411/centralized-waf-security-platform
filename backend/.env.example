# Copy to backend/.env for local development. In AWS these come from ECS task secrets (Secrets Manager).
SAS_ENVIRONMENT=local
SAS_DATABASE_URL=postgresql+asyncpg://sas:sas_local_dev@localhost:5433/sas_waf
SAS_REDIS_URL=redis://localhost:6379/0
SAS_FRONTEND_URL=http://localhost:5000
SAS_CORS_ORIGINS=["http://localhost:5000"]
# Secure cookies need HTTPS; may only be false when SAS_ENVIRONMENT is local or test.
SAS_COOKIE_SECURE=false

# OIDC provider fronting AWS IAM Identity Center (e.g. Identity Center OAuth app, or Cognito federated
# to Identity Center via SAML). Users must be pre-provisioned in the `users` table by sso_subject_id.
SAS_OIDC_ISSUER=https://example-issuer.invalid
SAS_OIDC_CLIENT_ID=replace-me
SAS_OIDC_CLIENT_SECRET=replace-me
SAS_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
SAS_OIDC_REQUIRE_MFA=true
