# Self-hosted staging settings. Copy to .env and fill in. The EC2 host stack (infra/staging/host.yaml) writes
# this file on the instance for you.
COMPOSE_PROFILES=app

# Public IP or DNS name the console is served on, without https:// (e.g. 203.0.113.10 or waf.example.com)
SITE_ADDRESS=localhost
# "internal" = Caddy's own certificate (browser warning until you trust it; works with an IP address)
# or an email address = free Let's Encrypt certificate (needs a DNS name and port 80 reachable from the internet)
CADDY_TLS=internal

AWS_REGION=us-east-1
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Must match the StackSet parameters DiscoveryExternalId / ResponseExternalId (generate with: openssl rand -hex 32)
DISCOVERY_EXTERNAL_ID=
RESPONSE_EXTERNAL_ID=

# Sign-in. Operator sign-in = enter the email of a provisioned user; only for an admin-only network.
OPERATOR_LOGIN=true
# Optional SSO (OIDC). Leave empty to use operator sign-in only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional threat-intelligence keys (JSON); an empty key disables that provider. Leave empty for none.
TI_KEYS_JSON=
